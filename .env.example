# Copy this file to .env and fill it in. .env is gitignored, so these stay private.
# Anything already set in the environment wins over .env.

# Where Ollama is running.
OLLAMA_BASE_URL=http://localhost:11434

# Browser mode: where it listens. Keep it on localhost or a private network like Tailscale.
DEVSERVER_WEB_HOST=127.0.0.1
DEVSERVER_WEB_PORT=8787

# Browser login. Usually set once with `python -m ai_terminal.web_auth` (saved in ~/.devserver);
# uncomment these to set it here instead.
# DEVSERVER_WEB_USER=your-username
# DEVSERVER_WEB_PASSWORD=change-me

# Optional: the folder that holds your projects (default: the folder above this repo).
# DEVSERVER_PROJECTS_DIR=/path/to/Projects
